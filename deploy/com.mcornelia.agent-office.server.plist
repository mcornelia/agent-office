<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mcornelia.agent-office.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>REPOSITORY_PATH/server.py</string>
    <string>--codex-dir</string><string>CODEX_PATH</string>
    <string>--port</string><string>4319</string>
    <string>--public-host</string><string>glyph.local:4318</string>
    <string>--roster-path</string><string>REPOSITORY_PATH/manager/team.json</string>
    <string>--identity-path</string><string>SUPPORT_PATH/identities.json</string>
  </array>
  <key>WorkingDirectory</key><string>REPOSITORY_PATH</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>LOG_PATH/agent-office.out.log</string>
  <key>StandardErrorPath</key><string>LOG_PATH/agent-office.err.log</string>
</dict>
</plist>
